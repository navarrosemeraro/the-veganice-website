---
interface Props {
  nome: string;
  descricao: string;
  imagem: string;
  categoria?: string;
  linkPedido: string;
  textoBotao?: string;
}

const { nome, descricao, imagem, categoria, linkPedido, textoBotao = "Encomendar no WhatsApp" } = Astro.props;
---

<div class="bg-[#F6EEE3] rounded-3xl p-5 border border-[#B7CEAE]/50 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
  <div>
    <div class="overflow-hidden rounded-2xl h-56 mb-4 bg-[#F3E1CB] relative">
      <img src={imagem} alt={nome} class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
      {categoria && (
        <span class="absolute top-3 right-3 bg-[#FFD0CC] text-[#456D57] text-xs font-bold px-3 py-1 rounded-full shadow-sm">
          {categoria}
        </span>
      )}
    </div>
    <h3 class="text-xl font-bold text-[#456D57] mb-2">{nome}</h3>
    <p class="text-sm font-light text-[#456D57]/80 leading-relaxed mb-6">{descricao}</p>
  </div>
  
  <a 
    href={linkPedido} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="w-full py-3 px-4 bg-[#456D57] text-[#F6EEE3] text-sm font-bold rounded-xl text-center hover:bg-[#456D57]/90 transition-all flex items-center justify-center gap-2"
  >
    <span>{textoBotao}</span>
  </a>
</div>