<!-- Barra Flutuante de Atalhos Rápidos -->
<div 
  id="quick-nav" 
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 opacity-0 pointer-events-none translate-y-4 transition-all duration-300 ease-in-out w-[90%] max-w-md"
>
  <nav class="bg-[#456D57]/95 backdrop-blur-md text-[#F6EEE3] px-4 py-2.5 rounded-full shadow-lg border border-[#B7CEAE]/40 flex items-center justify-between text-xs sm:text-sm font-semibold">
    
    <a 
      href="#bolos" 
      class="hover:text-[#FFD0CC] transition-colors px-2 py-1 rounded-md hover:bg-[#355443]"
    >
      🎂 Bolos
    </a>

    <span class="text-[#B7CEAE]/40">|</span>

    <a 
      href="#as-chefs" 
      class="hover:text-[#FFD0CC] transition-colors px-2 py-1 rounded-md hover:bg-[#355443]"
    >
      👩‍🍳 As Chefs
    </a>

    <span class="text-[#B7CEAE]/40">|</span>

    <a 
      href="#doces" 
      class="hover:text-[#FFD0CC] transition-colors px-2 py-1 rounded-md hover:bg-[#355443]"
    >
      🍬 Doces
    </a>

    <span class="text-[#B7CEAE]/40">|</span>

    <a 
      href="#delivery" 
      class="hover:text-[#FFD0CC] transition-colors px-2 py-1 rounded-md hover:bg-[#355443]"
    >
      🛵 Delivery
    </a>

  </nav>
</div>

<!-- Script para exibir/ocultar a barra ao rolar a página -->
<script>
  const quickNav = document.getElementById('quick-nav');

  function handleScroll() {
    // Mostra a barra quando a rolagem passar de 300px
    if (window.scrollY > 300) {
      quickNav?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
      quickNav?.classList.add('opacity-100', 'translate-y-0');
    } else {
      quickNav?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
      quickNav?.classList.remove('opacity-100', 'translate-y-0');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
</script>