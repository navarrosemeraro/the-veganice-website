---
import theVeganicesLogo from '../../public/logotipo/BRANCO/LOGO (16).png';
---

<header class="w-full bg-[#456D57] px-4 py-2.5">
  <nav class="mx-auto flex items-center justify-center gap-3 md:gap-5 font-bold text-base md:text-lg text-[#FFFFFF]">
    
    <!-- Link 1 -->
    <a href="#bolos" class="transition-colors hover:text-[#FFD0CC] tracking-wider">
      BOLOS
    </a>

    <!-- Divisor Vertical -->
    <span class="h-5 w-[1px] bg-[#B7CEAE]/60"></span>

    <!-- Link 2 -->
    <a href="#as-chefs" class="transition-colors hover:text-[#FFD0CC] tracking-wider">
      AS CHEFS
    </a>

    <!-- Divisor Vertical -->
    <span class="h-5 w-[1px] bg-[#B7CEAE]/60"></span>

    <!-- Logo Centralizada -->
    <a href="/" class="px-2 transition-opacity hover:opacity-80">
      <img 
        src={theVeganicesLogo.src} 
        alt="The Veganices Homepage" 
        class="w-32 md:w-40 h-auto" 
      />
    </a>

    <!-- Divisor Vertical -->
    <span class="h-5 w-[1px] bg-[#B7CEAE]/60"></span>

    <!-- Link 3 -->
    <a href="#delivery" class="transition-colors hover:text-[#FFD0CC] tracking-wider">
      DELIVERY
    </a>

    <!-- Divisor Vertical -->
    <span class="h-5 w-[1px] bg-[#B7CEAE]/60"></span>

    <!-- Link 4 -->
    <a href="#contato" class="transition-colors hover:text-[#FFD0CC] tracking-wider">
      CONTATO
    </a>

  </nav>
</header>

