---
interface Props {
  titulo: string;
  breadcrumb: string;
}

const { titulo, breadcrumb } = Astro.props;
---

<section class="relative bg-[#F3E1CB] text-[#456D57] pt-8 pb-16 px-4 overflow-hidden bg-[url('/pattern/rosa-10.png')] bg-repeat bg-[size:160px]">
  <div class="absolute inset-0 bg-[#F3E1CB]/85 backdrop-blur-[1px]"></div>

  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-2 text-[#456D57]">
      {titulo}
    </h1>

    <nav class="flex justify-center items-center gap-2 text-xs sm:text-sm font-medium tracking-wider text-[#456D57]/80 uppercase">
      <a href="/" class="hover:underline hover:text-[#456D57] transition-colors">Início</a>
      <span>—</span>
      <span class="font-bold text-[#456D57]">{breadcrumb}</span>
    </nav>
  </div>

  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-20">
    <svg class="relative block w-full h-6 sm:h-8 md:h-10 text-[#F6EEE3]" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0 C150,60 350,-20 500,40 C650,100 900,10 1200,30 L1200,120 L0,120 Z" fill="currentColor"></path>
    </svg>
  </div>
</section>