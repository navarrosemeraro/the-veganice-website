---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SubHeader from '../components/SubHeader.astro';
import PageBanner from '../components/PageBanner.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="As Chefs & Nossa História | The Veganices">
  <div class="relative min-h-screen bg-[url('/pattern/rosa-10.png')] bg-repeat bg-[size:2000px]">
    <div class="absolute inset-0 bg-[#F6EEE3]/90 backdrop-blur-[1px]"></div>

    <div class="relative z-10 flex flex-col min-h-screen justify-between">
      <div>
        <Header />
        <SubHeader />

        <PageBanner titulo="As Chefs 🌟" breadcrumb="Nossa história" />

        <main class="max-w-5xl mx-auto px-4 py-12 space-y-16">
          
          <!-- 1. História da Marca -->
          <section class="bg-[#F6EEE3] rounded-3xl p-8 md:p-12 border border-[#B7CEAE]/50 shadow-sm text-center max-w-3xl mx-auto">
            <span class="inline-block px-4 py-1 bg-[#FFD0CC] text-[#456D57] text-xs font-bold uppercase tracking-widest rounded-full mb-4">
              Como Tudo Começou
            </span>
            <h2 class="text-3xl md:text-4xl font-bold text-[#456D57] mb-6">
              Amor pela Confeitaria & Respeito aos Animais
            </h2>
            <div class="space-y-4 text-base md:text-lg font-light text-[#456D57]/90 leading-relaxed text-justify md:text-center">
              <p>
                texto texto texto textotexto texto texto textotexto texto texto texto
              </p>
              <p>
                texto texto texto textotexto texto texto textotexto texto texto texto
              </p>
            </div>
            
            <!-- Divisor decorativo -->
            <div class="flex items-center justify-center gap-2 mt-8">
              <span class="h-px w-12 bg-[#B7CEAE]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#456D57]"></span>
              <span class="h-px w-12 bg-[#B7CEAE]"></span>
            </div>
          </section>

          <!-- 2. Perfil das Chefs (Carol e Luisa) -->
          <section class="space-y-12">
            <div class="text-center">
              <h2 class="text-3xl md:text-4xl font-bold text-[#456D57]">
                Mãos que Adoçam a Vida
              </h2>
              <p class="text-sm md:text-base font-light text-[#456D57]/80 mt-2">
                Conheça quem idealiza e produz cada receita com dedicação diária.
              </p>
            </div>

            <!-- 1: Carol -->
            <div class="bg-[#F3E1CB]/60 rounded-3xl p-6 md:p-8 border border-[#B7CEAE]/40 shadow-sm flex flex-col md:flex-row items-center gap-8">
              <div class="w-48 h-48 md:w-64 md:h-64 rounded-2xl overflow-hidden shrink-0 bg-[#FFD0CC] border-2 border-[#456D57]/20 shadow-md">
                <img 
                  src="/chefs/carol.jpg" 
                  alt="Chef Carol" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="space-y-3 text-center md:text-left">
                <span class="px-3 py-1 bg-[#456D57] text-[#F6EEE3] text-xs font-bold rounded-full uppercase tracking-wider">
                  Administradora
                </span>
                <h3 class="text-2xl md:text-3xl font-bold text-[#456D57]">Carol</h3>
                <p class="text-sm md:text-base font-light text-[#456D57]/90 leading-relaxed">
                  [Bio Carol].
                </p>
                <p class="text-xs font-medium italic text-[#456D57]/70 pt-2">
                  "Doce preferido: [Ex: Bolo Red Velvet]"
                </p>
              </div>
            </div>

            <!-- 2: Luisa -->
            <div class="bg-[#F3E1CB]/60 rounded-3xl p-6 md:p-8 border border-[#B7CEAE]/40 shadow-sm flex flex-col md:flex-row-reverse items-center gap-8">
              <div class="w-48 h-48 md:w-64 md:h-64 rounded-2xl overflow-hidden shrink-0 bg-[#FFD0CC] border-2 border-[#456D57]/20 shadow-md">
                <img 
                  src="/chefs/luisa.jpg" 
                  alt="Chef Luisa" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="space-y-3 text-center md:text-left">
                <span class="px-3 py-1 bg-[#456D57] text-[#F6EEE3] text-xs font-bold rounded-full uppercase tracking-wider">
                  Chef Confeiteira
                </span>
                <h3 class="text-2xl md:text-3xl font-bold text-[#456D57]">Luisa</h3>
                <p class="text-sm md:text-base font-light text-[#456D57]/90 leading-relaxed">
                  [Bio Luísa].
                </p>
                <p class="text-xs font-medium italic text-[#456D57]/70 pt-2">
                  "Doce preferido: [Ex: Brigadeiro]"
                </p>
              </div>
            </div>
          </section>

          <!-- 3. Chamada Final / CTA -->
          <section class="bg-[#456D57] text-[#F6EEE3] rounded-3xl p-8 md:p-10 text-center space-y-4 shadow-md">
            <h3 class="text-2xl md:text-3xl font-bold">
              Quer experimentar nossas criações?
            </h3>
            <p class="text-sm md:text-base font-light opacity-90 max-w-xl mx-auto">
              Confira nossos cardápios completos ou peça diretamente via WhatsApp para encomendar seu bolo personalizado.
            </p>
            <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
              <a 
                href="/bolos" 
                class="px-6 py-3 bg-[#FFD0CC] text-[#456D57] font-bold rounded-xl text-sm hover:bg-[#FFD0CC]/90 transition-all shadow-sm"
              >
                Ver Bolos
              </a>
              <a 
                href="/doces" 
                class="px-6 py-3 bg-[#F6EEE3] text-[#456D57] font-bold rounded-xl text-sm hover:bg-[#F6EEE3]/90 transition-all shadow-sm"
              >
                Ver Docinhos
              </a>
            </div>
          </section>

        </main>
      </div>

      <Footer />
    </div>
  </div>
</Layout>