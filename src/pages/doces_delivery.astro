---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SubHeader from '../components/SubHeader.astro';
import PageBanner from '../components/PageBanner.astro';
import CardProduto from '../components/CardProduto.astro';
import Footer from '../components/Footer.astro';

import { produtosAutorais } from '../data/delivery';
---

<Layout title="Pronta Entrega & Delivery | The Veganices">
  <div class="relative min-h-screen bg-[url('/pattern/rosa-10.png')] bg-repeat bg-[size:2000px]">
    
    <!-- Overlay suave -->
    <div class="absolute inset-0 bg-[#F6EEE3]/90 backdrop-blur-[1px]"></div>

    <div class="relative z-10 flex flex-col min-h-screen justify-between">
      <div>
        <Header />
        <SubHeader />

        <PageBanner titulo="Pronta Entrega & Delivery" breadcrumb="Delivery & Loja" />

        <main class="max-w-6xl mx-auto px-4 py-8 space-y-16">
          
          <!-- Banner Superior de Pedidos -->
          <section class="bg-[#F3E1CB] rounded-3xl p-6 md:p-8 border border-[#B7CEAE] shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="text-center md:text-left space-y-1">
              <span class="px-3 py-1 bg-[#456D57] text-[#F6EEE3] text-xs font-bold uppercase tracking-wider rounded-full inline-block">
                Peça Agora
              </span>
              <h2 class="text-xl md:text-2xl font-bold text-[#456D57]">
                Disponível no iFood e Goomer
              </h2>
              <p class="text-xs md:text-sm font-light text-[#456D57]/80">
                Entregas rápidas de produtos congelados, sobremesas e itens de parceiros.
              </p>
            </div>

            <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
              <!-- Botão Goomer -->
              <a 
                href="https://goomer.app/theveganices" 
                target="_blank" 
                class="flex-1 md:flex-initial flex items-center justify-center gap-2 px-5 py-3 bg-[#456D57] text-[#F6EEE3] font-bold rounded-xl text-xs sm:text-sm hover:bg-[#456D57]/90 transition-all text-center shadow-sm"
              >
                <!-- Logo/Ícone Goomer -->
                <img src="/icons/goomer.png" alt="Goomer" class="w-5 h-5 object-contain" />
                <span>Abrir Goomer</span>
              </a>

              <!-- Botão iFood -->
              <a 
                href="https://www.ifood.com.br" 
                target="_blank" 
                class="flex-1 md:flex-initial flex items-center justify-center gap-2 px-5 py-3 bg-[#EA1D2C] text-white font-bold rounded-xl text-xs sm:text-sm hover:bg-[#c81624] transition-all text-center shadow-sm"
              >
                <!-- Logo iFood -->
                <img src="/icons/ifood.png" alt="Goomer" class="w-5 h-5 object-contain" />
                <span>Abrir iFood</span>
              </a>
            </div>
          </section>

          <!-- SEÇÃO 1: Nossos Congelados & Pronta Entrega -->
          <section class="space-y-6">
            <div class="flex items-center justify-between border-b border-[#B7CEAE]/50 pb-4">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-[#456D57]/70">Produção Própria</span>
                <h2 class="text-2xl md:text-3xl font-bold text-[#456D57]">
                  ❄️ Doces & Congelados
                </h2>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {produtosAutorais.map(item => (
                <CardProduto 
                  nome={item.nome}
                  descricao={item.descricao}
                  imagem={item.imagem}
                />
              ))}
            </div>
          </section>
        </main>
      </div>

      <Footer />
    </div>
  </div>
</Layout>